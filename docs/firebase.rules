rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is the super admin or in the admins collection (case-insensitive)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'greenadventurenepal19@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }
    
    // Admins Collection:
    // Only authenticated users who are ALREADY admins (or the super admin) can read or write.
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Contacts Collection:
    // Anyone can create a contact request (unauthenticated).
    // Only admins can read, update, or delete them.
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Settings Collection:
    // Anyone can read public site settings.
    // Only admins can write/update settings.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Trips Collection:
    // Anyone can read trips (for the Home Page).
    // Only admins can write/update/delete trips.
    match /trips/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Regions Collection:
    // Anyone can read regions (for the Home Page and Destinations Page).
    // Only admins can write/update/delete regions.
    match /regions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews Collection:
    // Anyone can read reviews (the home page filters to `status == "approved"` client-side).
    // Anyone can submit a new review (must default to status: "pending"; no admin-only fields).
    // Only admins can update (approve/reject) or delete reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.status == "pending"
                    && request.resource.data.name is string
                    && request.resource.data.message is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.message.size() <= 1000;
      allow update, delete: if isAdmin();
    }


    // Blogs Collection:
    // Anyone can read published blogs.
    // Anyone can submit a story (status must be "pending_review" with required fields).
    // Only admins can update, delete, or create admin posts.
    match /blogs/{blogId} {
      allow read: if true;
      allow create: if (
        request.resource.data.status == "pending_review"
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.submittedBy is map
        && request.resource.data.submittedBy.name is string
        && request.resource.data.submittedBy.email is string
      ) || isAdmin();
      allow update, delete: if isAdmin();
    }


    // Default fallback (Original rule provided by user)
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
